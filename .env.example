# FarmPulse AI - Environment Configuration Example

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./farmpulse.db

# Machine Learning & Simulation
RANDOM_SEED=42
SIMULATION_TICK_SECONDS=2
ALERT_THRESHOLD_HIGH=0.75
ALERT_THRESHOLD_MEDIUM=0.45

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
